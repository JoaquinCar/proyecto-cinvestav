# Base de datos (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Storage
# Buckets requeridos: "constancias" (PDFs) y el de imágenes de clase (ver abajo).
# Si estas variables faltan, las imágenes de clase se guardan como data URI en la base
# de datos y se limitan a 1 MB por imagen.
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Bucket de Storage para las imágenes de las clases. Debe ser PRIVADO: en estas
# fotos aparecen menores de edad, y un bucket público las deja al alcance de
# cualquiera que tenga la URL, sin sesión. La app sube con la clave service_role
# (se salta RLS) y sirve la lectura con URLs firmadas de 30 minutos, generadas en
# el servidor solo para quien tiene sesión. Si se omite, se usa "clases".
SUPABASE_BUCKET_CLASES="clases"

# NextAuth v5 (AUTH_SECRET reemplaza a NEXTAUTH_SECRET)
NEXTAUTH_URL="https://pasaporte-cientifico.vercel.app"
AUTH_SECRET=
NEXTAUTH_SECRET="[generar con: openssl rand -base64 32]"

# App
NEXT_PUBLIC_APP_NAME="Pasaporte Científico CINVESTAV"
