# Base de datos (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Storage
# Buckets requeridos: "constancias" (PDFs) y "clases" (imágenes de cada clase, lectura pública).
# Si estas variables faltan, las imágenes de clase se guardan como data URI en la base
# de datos y se limitan a 1 MB por imagen.
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# NextAuth v5 (AUTH_SECRET reemplaza a NEXTAUTH_SECRET)
NEXTAUTH_URL="https://pasaporte-cientifico.vercel.app"
AUTH_SECRET=
NEXTAUTH_SECRET="[generar con: openssl rand -base64 32]"

# App
NEXT_PUBLIC_APP_NAME="Pasaporte Científico CINVESTAV"
