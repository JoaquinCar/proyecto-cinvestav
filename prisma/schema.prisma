generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// AUTH

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(BECARIO)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sesionesRegistradas Sesion[]
  // Inscripciones a las que este usuario les quitó el derecho a constancia.
  // Es el lado inverso de `Inscripcion.constanciaExcluidaPor`: existe porque
  // Prisma lo exige, pero además responde "¿qué excluyó fulano?" de un tirón.
  constanciasExcluidas Inscripcion[]
}

enum Role {
  ADMIN
  BECARIO
  READONLY
}

// DOMINIO PRINCIPAL

model Edicion {
  id          String   @id @default(cuid())
  anio        Int      @unique
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime

  minAsistencias   Int     @default(5)
  porcentajeMinimo Float?
  asistenciaGlobal Boolean @default(true)

  activa    Boolean  @default(false)

  // Congelado de la edición. `activa` dice cuál es la edición en curso (solo una);
  // `cerrada` dice que una edición ya terminó y no admite más escrituras
  // (asistencias, sesiones, temas). Son cosas distintas: al abrir 2027, la 2026
  // deja de ser activa pero sigue abierta hasta que se capture lo que faltaba.
  // Es un acto explícito del ADMIN, no una deducción de fechaFin.
  cerrada   Boolean   @default(false)
  cerradaAt DateTime?

  createdAt DateTime @default(now())

  clases        Clase[]
  inscripciones Inscripcion[]
}

model Participante {
  id        String   @id @default(cuid())
  nombre    String
  apellidos String
  edad      Int
  escuela   String
  grado     String
  genero    Genero?
  nivel     String?
  correo    String?
  telefono  String?

  // De dónde viene el niño. La columna existía desde el importador de Excel,
  // pero el alta y la edición a mano no la pedían: todo niño capturado en la
  // aplicación quedaba sin ciudad y salía como «Sin especificar» en la gráfica
  // «Por ciudad» —justo la que el coordinador quiere leer.
  //
  // OPCIONAL a propósito, y se queda así: en los respaldos hay fichas sin
  // ciudad y la carga la hace una persona a mano, sesión por sesión. Un campo
  // obligatorio que no puede rellenar la deja atascada, y rellenarlo con
  // «Mérida» por omisión falsearía el único dato que se quiere analizar.
  //
  // Texto libre en la columna, pero NO texto libre en la aplicación: lo que se
  // guarda pasa siempre por `normalizarCiudad` (src/lib/ciudades.ts), que fija
  // la grafía contra un catálogo de Mérida y alrededores. La base solo sabe que
  // es texto; quién decide cómo se escribe es ese módulo, y es el único sitio.
  ciudad    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscripciones Inscripcion[]

  @@index([nombre, apellidos])
}

enum Genero {
  FEMENINO
  MASCULINO
}

// ── RETIRADO DE LA APLICACIÓN (sigue en el esquema, vacío) ───────────────────
//
// El acompañante NOMINAL —registrar al adulto con nombre, apellidos, teléfono
// y parentesco— se retiró de toda la aplicación. Palabras de Dario, del
// equipo, después de probar el sistema entero:
//
//   «Creo que es mejor quitar la parte de añadir acompañante de la parte de
//    registrar al niño y después. Con lo que acabas de añadir de agregar papás
//    y mamás ya funciona súper bien, tanto en las estadísticas como en el
//    registro. […] Ya con eso cumple exactamente lo que necesitan, sin
//    necesidad de poner el nombre de papá o mamá y esas cosas.»
//
// Lo que el programa necesita es cuántas mamás y cuántos papás vinieron a cada
// fecha, y eso vive en `Sesion.acompanantesMamas` / `acompanantesPapas`, que
// SÍ se usa y no tiene nada que ver con esta tabla.
//
// Por qué la tabla se queda en el esquema y NO hay migración que la borre:
//   1. Los respaldos que ya están en el USB del proyecto traen filas de
//      acompañantes. Si se borra la tabla, esos respaldos dejan de poder
//      restaurarse enteros.
//   2. Si el equipo cambia de opinión, volver atrás no exige migración: basta
//      con reponer el código de la aplicación.
//
// En producción hay 0 acompañantes, así que no se perdió ningún dato.
//
// ── Lo que era ───────────────────────────────────────────────────────────────
//
// El adulto (o el grupo organizado) con el que llega el niño.
//
// Era una PERSONA global, igual que Participante: existía una vez y se
// reutilizaba año tras año y entre hermanos, para que dos hermanos pudieran
// compartir la misma ficha sin duplicarla.
//
// NO sustituía a Participante.correo / telefono: esos campos siguen guardando
// el contacto tal como vino del Excel y no se tocan aquí.
model Acompanante {
  id         String     @id @default(cuid())
  nombre     String
  apellidos  String?
  telefono   String?
  correo     String?
  parentesco Parentesco @default(OTRO)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  inscripciones Inscripcion[]

  @@index([nombre, apellidos])
}

// RETIRADO con `model Acompanante` (ver arriba): ya no lo escribe ni lo lee
// nada de la aplicación. Se conserva porque la columna `Acompanante.parentesco`
// lo usa y los respaldos del USB lo traen.
//
// Qué era: quién es ese adulto respecto del niño. Incluía GRUPO e INSTITUCION a
// propósito, porque el contacto que trae a 25 niños no es su tutor sino un
// colectivo, y obligarlo a decir "TUTOR" falsearía el dato.
enum Parentesco {
  MADRE
  PADRE
  ABUELA
  ABUELO
  TIA
  TIO
  TUTOR
  GRUPO
  INSTITUCION
  OTRO
}

model Inscripcion {
  id                 String   @id @default(cuid())
  participanteId     String
  edicionId          String
  // RETIRADO de la aplicación (ver `model Acompanante`): ninguna pantalla ni
  // endpoint lo escribe ni lo lee ya. Se queda en el esquema, siempre null,
  // para no romper los respaldos del USB y para poder volver atrás sin
  // migración.
  //
  // Qué era: quién acompañó al niño ESTA edición. Vivía en la inscripción y no
  // en el participante porque cambiaba de un año a otro.
  acompananteId      String?
  constanciaUrl      String?
  constanciaGenerada Boolean  @default(false)

  // ── Quién NO recibe constancia ──────────────────────────────────────────
  //
  // La política es "constancia para todos los inscritos"; el mínimo de
  // asistencias de la edición dejó de decidirlo (ver src/server/queries/
  // constancias.ts). Lo único que deja a un niño sin constancia es que un
  // ADMIN lo marque aquí, uno por uno o en bloque.
  //
  // Por qué vive en la inscripción y NO en el participante: la exclusión es
  // de UNA edición. Un niño excluido en 2026 porque se dio de baja a media
  // edición vuelve en 2027 con derecho pleno, sin que nadie tenga que
  // acordarse de reincorporarlo. Una exclusión permanente no existe en el
  // dominio: el programa es anual y cada año se vuelve a inscribir.
  //
  // El `false` por defecto es lo que hace que las inscripciones ya cargadas
  // queden correctas sin tocar ni una fila: todas con derecho.
  constanciaExcluida        Boolean   @default(false)
  constanciaMotivoExclusion String?
  constanciaExcluidaAt      DateTime?
  constanciaExcluidaPorId   String?

  createdAt          DateTime @default(now())

  participante Participante @relation(fields: [participanteId], references: [id])
  edicion      Edicion      @relation(fields: [edicionId], references: [id])
  // Relación retirada de la aplicación junto con `model Acompanante`. El
  // Restrict se conserva tal cual: era lo que impedía que borrar a un adulto
  // desligara en silencio a varios niños a la vez.
  acompanante  Acompanante? @relation(fields: [acompananteId], references: [id], onDelete: Restrict)
  asistencias  Asistencia[]
  // Restrict, no SetNull: dejar a un niño sin constancia es una decisión que
  // alguien tendrá que justificar, y con SetNull bastaría con borrar al
  // usuario para que la exclusión quedara sin autor. Si hay que dar de baja a
  // quien excluyó, primero se revisan sus exclusiones.
  constanciaExcluidaPor User? @relation(fields: [constanciaExcluidaPorId], references: [id], onDelete: Restrict)

  @@unique([participanteId, edicionId])
  @@index([acompananteId])
  @@index([edicionId, constanciaExcluida])
  @@index([constanciaExcluidaPorId])
}

// OJO — el nombre del modelo NO coincide con lo que se lee en pantalla.
//
// La interfaz llama «sesión» a ESTE registro: la charla que imparte un
// investigador, con su nombre, su descripción y sus imágenes. El cliente pidió
// ese vocabulario porque además de las charlas normales habrá sesiones de
// lectura y eventos especiales (día del niño, clausura), y «sesión» es la
// palabra paraguas que los cubre a todos; «clase» no.
//
// El modelo `Sesion` de más abajo es la FECHA en que se imparte esa charla —en
// la práctica una sola por `Clase`— y en pantalla se llama «fecha».
//
//   base de datos          interfaz
//   ─────────────          ────────
//   Clase                  sesión
//   Sesion                 fecha (de la sesión)
//   ImagenClase            imagen de la sesión
//
// Los nombres internos (modelos, `claseId`, `sesionId`, relaciones, rutas
// /clases y /api/clases) se dejaron como estaban a propósito: renombrarlos
// habría multiplicado el diff y roto los merges pendientes, sin ganar nada.
model Clase {
  id        String   @id @default(cuid())
  edicionId String
  nombre    String

  // Qué clase de actividad es. En pantalla se lee como «tipo de sesión».
  // PASAPORTE es el DEFAULT a propósito: las 12 sesiones que ya existían son
  // charlas del programa, y el valor por defecto las deja correctas sin que
  // nadie tenga que reescribirlas. Ver el enum `TipoClase`.
  tipo TipoClase @default(PASAPORTE)

  // Opcional desde que existen los eventos especiales: una clausura o un día
  // del niño no lo imparte ningún investigador, y obligar a inventar uno
  // metería basura en el reporte de la edición. Sigue siendo obligatorio para
  // los otros dos tipos, pero eso se exige en Zod (ver `crearClaseSchema`), no
  // en la columna: la base solo sabe que puede faltar.
  investigador String?

  // El cuerpo del informe: lo que en el formato Word del cliente se titula
  // «Desarrollo de actividad».
  //
  // NO se creó un campo `desarrollo` aparte, a pesar de que el formato use ese
  // nombre. En los 12 informes reales de 2026, ese recuadro contiene una
  // narración de qué trató la sesión y qué se hizo —una o tres párrafos de
  // prosa—, que es exactamente lo que esta columna guarda y lo que el diálogo
  // de la aplicación ya pide («Qué se hace en esta sesión, materiales,
  // objetivos…»). Dos campos de texto libre con significados que se solapan
  // —«descripción» y «desarrollo»— garantizarían que la mitad del contenido
  // acabe en el recuadro equivocado y que el informe salga a medias.
  descripcion String?

  // ── Los dos campos que el formato Word lleva y el modelo no tenía ──────────
  //
  // Ambos son OPCIONALES y nacen en NULL: un informe tiene que poder salir el
  // mismo día de la sesión, cuando el objetivo está pero los comentarios
  // todavía no se han escrito. La exportación quita el recuadro entero cuando
  // el campo está vacío, en vez de imprimir un marco en blanco.

  // El recuadro «Objetivo:» del encabezado del informe.
  objetivo String?

  // El recuadro «Comentarios» del cierre: las conclusiones que el coordinador
  // escribe DESPUÉS de impartir la sesión («la plática logró despertar el
  // interés…»). Es valoración, no descripción, y por eso no cabe en
  // `descripcion`.
  comentarios String?

  createdAt   DateTime @default(now())

  edicion  Edicion       @relation(fields: [edicionId], references: [id])
  sesiones Sesion[]
  imagenes ImagenClase[]
  // Quién imparte u organiza esta sesión (ver `model Staff`, más abajo).
  staff    StaffClase[]

  // Las pantallas listan «las sesiones de pasaporte de esta edición» o «los
  // eventos de esta edición»: siempre edición + tipo.
  @@index([edicionId, tipo])
}

// Los tres tipos de actividad del programa. El cliente los distingue así:
//
//   PASAPORTE — la charla normal, lo que el programa ES. Solo estas cuentan
//               para el mínimo de asistencias de la constancia.
//   LECTURA   — sesión de lectura. Es un extra OPCIONAL: se ofrece, pero no
//               forma parte del pasaporte.
//   EVENTO    — evento especial (día del niño, clausura). Independiente: un
//               mismo día puede haber una sesión de pasaporte y además el
//               evento, y son dos registros distintos.
//
// OJO: cuál de estos cuenta para la constancia NO se decide aquí. Vive en
// `TIPOS_QUE_CUENTAN_PARA_CONSTANCIA`, en src/lib/tipos-sesion.ts, que es el
// único sitio donde se cambia.
enum TipoClase {
  PASAPORTE
  LECTURA
  EVENTO
}

// Imágenes de apoyo de una clase (fotos, carteles, capturas pegadas del portapapeles).
// `url` guarda una referencia interna `supabase://…` cuando el bucket está configurado
// —NO una URL pública: el bucket es privado y el archivo se sirve por el proxy
// autenticado—; si no lo está, guarda un data URI en base64 como respaldo
// (ver src/server/queries/imagenes-clase.ts).
model ImagenClase {
  id          String   @id @default(cuid())
  claseId     String
  url         String
  storagePath String?
  titulo      String?
  mimeType    String

  tamano Int @default(0)

  // Posición de la foto dentro de su sesión, empezando en 0 y sin huecos.
  //
  // No es decorativo: la exportación a Word imprime las fotos en este orden, y
  // el orden lo decide quien arma el reporte. Por eso hay dos garantías:
  //
  //   · La unicidad de (claseId, orden) impide empates. Nacieron todas en 0 —el
  //     default de antes—, así que la migración las renumeró por antigüedad
  //     antes de poder exigirlo.
  //   · El reordenado escribe la secuencia completa 0…n-1 dentro de una
  //     transacción (`reordenarImagenesDeClase`), así que tampoco quedan huecos
  //     al borrar una foto de en medio.
  //
  // El `@default(0)` se queda solo para que una fila insertada a mano no reviente;
  // el alta real calcula siempre el siguiente libre.
  orden Int @default(0)

  createdAt DateTime @default(now())

  clase Clase @relation(fields: [claseId], references: [id], onDelete: Cascade)

  // Cubre tanto el filtro por sesión como el ORDER BY de la galería.
  @@unique([claseId, orden])
  @@index([claseId])
}

model Sesion {
  id              String   @id @default(cuid())
  claseId         String
  fecha           DateTime
  temas           String?
  notas           String?
  registradaPorId String?
  createdAt       DateTime @default(now())

  // ── Cuántos adultos acompañaron en ESTA fecha ──────────────────────────────
  //
  // Dos números y nada más, los que se cuentan al pasar lista. NO es una lista
  // nominal de adultos: eso existió (`Acompanante` ligado a la `Inscripcion`) y
  // se retiró por sobrar — estos dos números son lo único que el programa
  // necesita. El coordinador fue explícito: «solo número, no lista de papás».
  //
  // Por qué aquí y no en `ResumenSesion`, que ya tiene columnas `mamas` y
  // `papas`: ese modelo es la foto agregada que entra POR EL IMPORTADOR del
  // Excel, y su sola existencia significa tres cosas en el código — que la
  // asistencia de la fecha está capturada (`SESION_CAPTURADA`), que el origen
  // de los números es AGREGADA y manda sobre la lista individual
  // (`asistenciaDeSesion`), y que la sesión tiene datos que no se borran sin
  // forzar (`eliminarClase`). Crear un `ResumenSesion` desde la pantalla de
  // pasar lista solo para apuntar «4 mamás» activaría las tres: la fecha
  // contaría como capturada sin estarlo, sus totales de niños (0 por defecto)
  // taparían a los de la lista real, y la siguiente importación del Excel
  // pisaría el conteo escrito a mano con su propio upsert. Aquí no hay ninguna
  // de esas interferencias y la importación no se toca.
  //
  // NULLables, no `@default(0)`: NULL es «nadie los contó» y 0 es «no vino
  // ninguno», y son respuestas distintas. Además es lo que hace la migración
  // segura sobre una base con datos restaurada de un respaldo — las fechas ya
  // cargadas nacen en NULL y sus acompañantes siguen saliendo del
  // `ResumenSesion` importado, con los mismos números de siempre.
  acompanantesMamas Int?
  acompanantesPapas Int?

  clase         Clase          @relation(fields: [claseId], references: [id])
  registradaPor User?          @relation(fields: [registradaPorId], references: [id])
  asistencias   Asistencia[]
  resumen       ResumenSesion?
}

// Totales agregados de asistencia por sesión (sin nombres — provienen del Excel del organizador).
// Coexiste con Asistencia individual; aquí se guardan los conteos para el análisis.
model ResumenSesion {
  id            String   @id @default(cuid())
  sesionId      String   @unique
  ninas         Int      @default(0)
  ninos         Int      @default(0)
  total         Int      @default(0)
  mamas         Int      @default(0)
  papas         Int      @default(0)
  preescolar    Int      @default(0)
  primaria      Int      @default(0)
  secundaria    Int      @default(0)
  mediaSuperior Int      @default(0)
  porEdad       Json?
  createdAt     DateTime @default(now())

  sesion Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
}

model Asistencia {
  id            String   @id @default(cuid())
  inscripcionId String
  sesionId      String
  presente      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // SIN onDelete: Cascade a propósito. Estas filas son el respaldo de la
  // constancia de un niño en una edición: si la FK borrara en cascada, dar de
  // baja una inscripción se llevaría el historial de asistencia sin que nadie
  // lo pidiera ni quedara rastro. La baja con historial se rechaza en la API
  // (DELETE /api/inscripciones/[id]) y solo se ejecuta, en una transacción
  // explícita, cuando el ADMIN lo confirma con ?forzar=true.
  inscripcion Inscripcion @relation(fields: [inscripcionId], references: [id])
  sesion      Sesion      @relation(fields: [sesionId], references: [id])

  @@unique([inscripcionId, sesionId])
}

// STAFF — quien IMPARTE U ORGANIZA una sesión.
//
// Es la tercera clase de persona del sistema y no se confunde con ninguna de
// las otras dos:
//   · `Participante` es el niño.
//   · `Acompanante` era el adulto con el que LLEGA el niño — RETIRADO de la
//     aplicación (ver su modelo), pero la distinción sigue valiendo: staff no
//     es ni fue nunca lo mismo que un acompañante.
//   · `Staff` es quien está del otro lado: el investigador que da la charla, el
//     becario que pasa lista, quien coordina o apoya en logística.
//   · `User` es una CUENTA del sistema. Un becario suele ser las dos cosas,
//     pero la mayoría del staff no tiene cuenta (y no debe tenerla para salir
//     en la lista), así que Staff no cuelga de User ni al revés.
//
// GLOBAL, como Participante — no por edición. El mismo becario vuelve año tras
// año y a veinte sesiones del mismo año: una ficha por persona es lo único que
// permite contar en cuántas participó. La edición no se pierde, se deduce por
// las sesiones a las que está asignado (StaffClase → Clase → Edicion).
model Staff {
  id          String   @id @default(cuid())
  nombre      String
  apellidos   String?
  telefono    String?
  correo      String?
  rol         RolStaff @default(OTRO)
  // Su adscripción tal como quiere que aparezca en la lista: "CINVESTAV
  // Mérida", "UADY", "Cinvestav — Depto. de Física Aplicada". Texto libre a
  // propósito: es una etiqueta para el anexo, no una entidad del sistema.
  institucion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sesiones StaffClase[]

  @@index([nombre, apellidos])
}

// Qué hace esa persona en el programa: describe a la persona, no una relación
// laboral ni un permiso del sistema. NO se confunde
// con `Role` (ADMIN / BECARIO / READONLY), que es lo que una CUENTA puede hacer.
enum RolStaff {
  INVESTIGADOR
  BECARIO
  COORDINACION
  APOYO
  VOLUNTARIO
  OTRO
}

// Enlace staff ↔ sesión (`Clase`, que en pantalla se llama «sesión»).
//
// Tabla de enlace explícita y no una m-n implícita de Prisma: la implícita crea
// una tabla `_ClaseToStaff` que nadie puede documentar ni consultar desde SQL
// con nombres reconocibles, y aquí hace falta poder decir desde cuándo está
// asignada una persona.
//
// El `@@unique` es el corazón del asunto: asignar dos veces a la misma persona
// a la misma sesión es imposible a nivel de base, no solo de interfaz.
model StaffClase {
  id        String   @id @default(cuid())
  staffId   String
  claseId   String
  createdAt DateTime @default(now())

  // Cascade sobre la sesión: la asignación no significa nada sin ella, y sin
  // esto un `DELETE` de una sesión sin fechas ni asistencias reventaría contra
  // la llave foránea con un error que no dice qué estorba (el mismo problema
  // que ya documenta `eliminarClase`).
  clase Clase @relation(fields: [claseId], references: [id], onDelete: Cascade)
  // Restrict sobre la persona: mismo criterio que `Inscripcion.acompananteId`.
  // Borrar a alguien que sigue asignado lo sacaría en silencio de varias
  // sesiones a la vez; primero se le quita de cada una.
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([staffId, claseId])
  @@index([claseId])
  @@index([staffId])
}

// NEXTAUTH — requerido por @auth/prisma-adapter (JWT strategy, sin modelo Session)

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
