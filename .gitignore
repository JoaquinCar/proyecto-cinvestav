# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# test artifacts
/test-results/
/playwright-report/

# prisma migrations generated client
/prisma/generated/

# scripts: datos personales de participantes (PII) y artefactos temporales — NUNCA subir
/scripts/data/

# Respaldos de la base. NUNCA se commitean: el repositorio es PÚBLICO y un
# volcado lleva nombre, edad, escuela, teléfono y correo de cada niño.
# Viajan en USB, de una generación de servicio social a la siguiente.
# Ver docs/respaldos.md
/respaldos/

# Reportes de pruebas: mencionan datos de la base de trabajo y este repositorio
# es público. Son notas, no documentación del proyecto.
/docs/qa/
/scripts/_*
